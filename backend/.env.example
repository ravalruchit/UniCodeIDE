# UniCodeIDE Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your actual MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/unicodeide

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173
